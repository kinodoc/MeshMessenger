# Copy to /etc/mesh-bugreport.env and chmod 600. Never commit real values.
BUGREPORT_HOST=127.0.0.1
BUGREPORT_PORT=8765
GITHUB_REPO=kinodoc/MeshMessenger
GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN
PUBLIC_BASE_URL=https://BUGREPORT-DOMAIN
REPORT_DIR=/var/lib/mesh-bugreports
MAX_UPLOAD_BYTES=10485760
